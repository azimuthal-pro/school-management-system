# Database Configuration
DB_HOST=localhost
DB_NAME=sms
DB_USER=root
DB_PASSWORD=

# JWT Secret - Generate a secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-this-to-a-very-secure-random-string-at-least-32-chars

# Frontend URL for CORS (must match your frontend's actual URL)
FRONTEND_URL=http://localhost:3000
